# Leave both values empty to use the deterministic local demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.jsdelivr.net/gh/yunjae305/NikkeURaid@main/assets
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key used by the Vercel lookup route to invoke request-sync.
# Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only administrator lock. Leave unset to keep /admin disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
